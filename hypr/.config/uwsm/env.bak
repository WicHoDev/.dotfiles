# ════════════════════════════════════════════════════════════════════
# uwsm Environment Variables - Common to ALL graphical sessions
# Location: ~/.config/uwsm/env
# ════════════════════════════════════════════════════════════════════
# These apply to GTK, Qt, theming, and NVIDIA toolkit variables.
# Format: one "export KEY=VALUE" per line, NO comments inline.
# ════════════════════════════════════════════════════════════════════

# ─── Cursor Configuration ──────────────────────────────────────────
export HYPRCURSOR_SIZE=24
export XCURSOR_SIZE=24
export XCURSOR_THEME="Bibata-Modern-Classic"

# ─── NVIDIA Toolkit Variables (Wayland-ready) ──────────────────────
# Enable NVIDIA VA-API hardware video decoding
export LIBVA_DRIVER_NAME="nvidia"

# GBM backend for NVIDIA Wayland
export GBM_BACKEND="nvidia-drm"

# Tells GLVND to use NVIDIA's GL implementation
export __GLX_VENDOR_LIBRARY_NAME="nvidia"

# ─── Wayland Application Compatibility ─────────────────────────────
# Force GTK apps to use Wayland (fallback to X11 if unavailable)
export GDK_BACKEND="wayland;x11"

# Force Qt apps to use Wayland (fallback to xcb/X11)
export QT_QPA_PLATFORM="wayland;xcb"

# SDL2 games use Wayland natively
export SDL_VIDEODRIVER="wayland"

# Use Wayland for Mozilla apps (Firefox, Thunderbird)
export MOZ_ENABLE_WAYLAND=1

# Enable native Wayland for Electron apps (VSCode, Discord, etc.)
export ELECTRON_OZONE_PLATFORM_HINT="auto"

# ─── Qt Theming ────────────────────────────────────────────────────
export QT_AUTO_SCREEN_SCALE_FACTOR=1
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1

# ─── XDG Variables ─────────────────────────────────────────────────
export XDG_CURRENT_DESKTOP="Hyprland"
export XDG_SESSION_TYPE="wayland"
export XDG_SESSION_DESKTOP="Hyprland"
